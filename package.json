{
  "name": "dsh-codex-429-nudge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Codex 自动继续：检测 Codex 应用因上游 429 或额度用尽而卡住，自动替你点「继续」；切走会话会自己找回来，多任务并行时逐个翻查",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "bin/codex-429-nudge.ps1",
    "standalone/**"
  ],
  "license": "MIT"
}
